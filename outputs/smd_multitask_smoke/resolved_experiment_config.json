{
  "checkpoint_dir": "outputs/smd_multitask_smoke/checkpoints",
  "data": {
    "batch_size": 8,
    "dataset_name": "smd",
    "max_test_windows": 128,
    "max_train_windows": 256,
    "max_val_windows": 128,
    "num_workers": 0,
    "root_dir": "data/ServerMachineDataset",
    "shuffle_train": true,
    "stride": 10,
    "validation_split_ratio": 0.2,
    "window_size": 100
  },
  "data_config_path": "configs/data/smd_smoke.yaml",
  "device": "cpu",
  "epochs": 1,
  "experiment_name": "smd_multitask_smoke",
  "logging": {
    "use_wandb": false,
    "wandb_mode": "offline",
    "wandb_project": "bachelor-thesis-2026"
  },
  "model": {
    "alpha_logit_init": 0.0,
    "beta_logit_init": 0.0,
    "continuous_enabled": true,
    "continuous_num_prototypes": 8,
    "discrete_codebook_size": 16,
    "discrete_enabled": true,
    "dropout": 0.1,
    "encoder_dim": 64,
    "gate_barrier_margin": 0.25,
    "gumbel_temperature": 1.5,
    "hidden_dim": 32,
    "input_dim": 38,
    "lambda_cls": 1.0,
    "lambda_cov": 0.0,
    "lambda_div": 0.0,
    "lambda_gate": 0.0,
    "lambda_use": 0.0,
    "lambda_var": 0.0,
    "model_name": "thesis_multitask",
    "num_classes": 2,
    "temperature_anneal_fraction": 0.8,
    "temperature_end": 0.7,
    "temperature_start": 1.5,
    "variance_floor_gamma": 1.0
  },
  "model_config_path": "configs/model/thesis_multitask.yaml",
  "optimizer": {
    "learning_rate": 0.001,
    "weight_decay": 0.0
  },
  "output_dir": "outputs/smd_multitask_smoke",
  "seed": 7,
  "task": {
    "anomaly_families": [
      "spike",
      "flip",
      "speedup",
      "noise",
      "cutoff",
      "average",
      "scale",
      "wander",
      "contextual",
      "upsidedown",
      "mixture"
    ],
    "anomaly_probability": 0.5,
    "freeze_fusion_for_epochs": 0,
    "max_segment_fraction": 0.2,
    "min_segment_fraction": 0.1,
    "spike_scale": 3.0,
    "task_name": "multitask_tsad",
    "use_synthetic_augmentation": true,
    "warmup_alpha_value": 0.5,
    "warmup_beta_value": 0.5
  },
  "task_config_path": "configs/task/multitask_tsad.yaml"
}