    }
   ],
   "source": [
    "plt.plot(df[\"time\"], df[\"abp\"])\n",
    "rect = Rectangle((24000, 2400), 2000, 6000, facecolor=\"lightgrey\")\n",
    "plt.gca().add_patch(rect)\n",
