   "source": [
    "df = pd.read_csv(\n",
    "    \"https://zenodo.org/record/4276400/files/Semantic_Segmentation_TiltABP.csv?download=1\"\n",
    ")\n",
    "df.head()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Visualizing the Raw Data"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "metadata": {},
   "outputs": [
