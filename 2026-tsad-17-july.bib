@misc{zhang_iclr-2026_2026,
	title = {{ICLR}-2026 - {Contextual} and {Seasonal} {LSTMs} for {Time} {Series} {Anomaly} {Detection}},
	url = {http://arxiv.org/abs/2602.09690},
	doi = {10.48550/arXiv.2602.09690},
	abstract = {Univariate time series (UTS), where each timestamp records a single variable, serve as crucial indicators in web systems and cloud servers. Anomaly detection in UTS plays an essential role in both data mining and system reliability management. However, existing reconstruction-based and prediction-based methods struggle to capture certain subtle anomalies, particularly small point anomalies and slowly rising anomalies. To address these challenges, we propose a novel prediction-based framework named Contextual and Seasonal LSTMs (CS-LSTMs). CS-LSTMs are built upon a noise decomposition strategy and jointly leverage contextual dependencies and seasonal patterns, thereby strengthening the detection of subtle anomalies. By integrating both time-domain and frequency-domain representations, CS-LSTMs achieve more accurate modeling of periodic trends and anomaly localization. Extensive evaluations on public benchmark datasets demonstrate that CS-LSTMs consistently outperform state-of-the-art methods, highlighting their effectiveness and practical value in robust time series anomaly detection.},
	urldate = {2026-03-26},
	publisher = {arXiv},
	author = {Zhang, Lingpei and Li, Qingming and Yang, Yong and Chen, Jiahao and Zeng, Rui and Lyu, Chenyang and Ji, Shouling},
	month = feb,
	year = {2026},
	note = {arXiv:2602.09690 [cs]},
	keywords = {Computer Science - Machine Learning},
	file = {PDF:/Users/conquerormikrokosmos/Zotero/storage/RYIJA8QH/Zhang et al. - 2026 - ICLR-2026 - Contextual and Seasonal LSTMs for Time Series Anomaly Detection.pdf:application/pdf;Snapshot:/Users/conquerormikrokosmos/Zotero/storage/DQ83MFXB/2602.html:text/html},
}

@article{wu_information-fusion-26_2026,
	title = {Information-{Fusion}-26 - {WAVAE}: {A} {Weakly} {Augmented} {Variational} {Autoencoder} for {Time} {Series} {Anomaly} {Detection}},
	volume = {125},
	issn = {1566-2535},
	shorttitle = {{WAVAE}},
	url = {https://www.sciencedirect.com/science/article/pii/S1566253525005354},
	doi = {10.1016/j.inffus.2025.103462},
	abstract = {In this work, we present WAVAE, a Weakly Augmented Variational Autoencoder that incorporates self-supervised learning (SSL) to improve likelihood estimation in time series anomaly detection. By augmenting the input data, our model enhances the robustness of latent space representations and increases the sensitivity to anomalies, achieving superior performance compared to traditional VAE-based Time Series Anomaly Detection (TSAD) models on five public datasets. Deep probabilistic generative models capture the likelihood of time series with deviating samples toward a low fitting score, thus capable of quantifying TSAD. Variational Autoencoders (VAEs) based TSAD models demonstrate their stable training and single-step generation capabilities. Existing VAE-based TSAD systems often redesign recurrent neural networks or introduce dynamic priors to model the spatio-temporal dependencies of time series, focusing on modeling the data distribution of normal samples. However, due to the scarcity of time-series data and disturbances from anomalous samples, these approaches face challenges with posterior collapse and mismatching the latent from encoded anomalies to high likelihood regions, resulting in a lack of robustness in the model. Accordingly, to increase the expressive of posteriors, we propose a Weakly Augmented VAE (WAVAE), which incorporates self-supervised learning (SSL) into VAE to augment input and better estimate the anomaly-sensitive likelihood for more robust reconstruction. Specifically, WAVAE mitigates the disruption of anomalies in the low-dimensional representation space, thus resulting in augmented latent representations for TSAD. By augmenting latent representations via enhanced training, WAVAE increases the robustness of estimating the likelihood of normal data and improves the sensitivity to anomalies. It synchronizes the training of both augmented and raw models and aligns their convergence during data likelihood optimization. This is achieved by maximizing mutual information in the Evidence Lower Bound with contrastive learning for shallow learning and a discriminator-based adversarial strategy for deep learning. WAVAE significantly advances VAE by integrating SSL into likelihood enhancement on five public synthetic and real datasets, validating the efficacy of WAVAE for TSAD, compared to state-of-the-art models and through comprehensive ablation studies. The Code is available in https://github.com/amasawa/WAVAE.},
	urldate = {2026-03-27},
	journal = {Information Fusion},
	author = {Wu, Zhangkai and Zhang, Qi and Zhou, Junxian and Chen, Hui and Liu, Yanfang},
	month = jan,
	year = {2026},
	keywords = {Generative model, Time series anomaly detection, Variational autoencoder},
	pages = {103462},
	file = {PDF:/Users/conquerormikrokosmos/Zotero/storage/KW937JQJ/Wu et al. - 2026 - Information-Fusion-26 - WAVAE A Weakly Augmented Variational Autoencoder for Time Series Anomaly De.pdf:application/pdf;ScienceDirect Snapshot:/Users/conquerormikrokosmos/Zotero/storage/3A3H74Z8/S1566253525005354.html:text/html},
}

